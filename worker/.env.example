# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supavisor Transaction Pooler, port 6543)
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Internal Edge Function
INTERNAL_EDGE_URL=https://your-project.supabase.co/functions/v1
INTERNAL_EDGE_TOKEN=generate-a-strong-random-token

# Worker
MAX_TASKS_PER_RUN=3
MAX_RUN_SECONDS=270
TEMP_DIR=/tmp/pvai
