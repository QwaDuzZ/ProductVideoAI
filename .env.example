# ============================================
# ProductVideoAI — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ---- Supabase ----
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Supabase (server-side / Edge Functions) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- LLM (OpenRouter) ----
OPENROUTER_API_KEY=sk-or-...

# ---- TTS (ElevenLabs) ----
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# ---- Video Generation (Seedance / Fal.ai) ----
FAL_KEY=...

# ---- Video Upscale (Replicate) ----
REPLICATE_API_TOKEN=...

# ---- Content Moderation (OpenRouter — same key as LLM) ----
# Uses OPENROUTER_API_KEY above

# ---- Webhooks ----
WEBHOOK_TOKEN=your-random-secret-token-here

# ---- Worker (Render Cron) ----
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?sslmode=require
INTERNAL_EDGE_URL=https://YOUR_PROJECT.supabase.co/functions/v1
INTERNAL_EDGE_TOKEN=YOUR_SERVICE_ROLE_KEY
MAX_TASKS_PER_RUN=3
MAX_RUN_SECONDS=270
TEMP_DIR=/tmp/pvai

# ---- Payment Gateways (fill when ready) ----
# Prodamus
PRODAMUS_SHOP_ID=
PRODAMUS_SECRET_KEY=

# PaySelection
PAYSELECTION_API_KEY=
PAYSELECTION_SHOP_ID=

# LavaTop
LAVATOP_API_KEY=

# CryptoCloud
CRYPTOCLOUD_SHOP_ID=
CRYPTOCLOUD_SECRET_KEY=
